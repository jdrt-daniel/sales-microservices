# --- Kafka ---
KAFKA_BROKER_INTERNAL=kafka:9092     # usado por los microservicios DENTRO de Docker
KAFKA_BROKER_EXTERNAL=localhost:9094 # usado si corres algún microservicio fuera de Docker

# --- Tu Postgres existente (una sola instancia, ya con tus BDs creadas) ---
# Cada microservicio se conecta con las mismas credenciales pero apuntando
# a SU base de datos dentro de esa instancia (ver *_DB_NAME de abajo).
DB_HOST=localhost
DB_PORT=5432
DB_USER=tu_usuario
DB_PASSWORD=tu_password

USERS_DB_NAME=db_users
PRODUCTS_DB_NAME=db_products
SALES_DB_NAME=db_sales
LOGS_DB_NAME=db_logs

# --- Logs (ms-logs consume "gateway.access.logs" y persiste en LOGS_DB_NAME) ---
KAFKA_CONSUMER_GROUP=ms-logs-consumer
