{
  "uid": "ecommerce-obs",
  "title": "Ecommerce Observability",
  "tags": ["ecommerce", "microservices"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Gateway (tráfico)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request rate (RPS)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"api-gateway\"}[1m]))",
          "legendFormat": "RPS"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latencia p50/p95 (s)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"api-gateway\"}[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{job=\"api-gateway\"}[5m])) by (le))",
          "legendFormat": "p50"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Error rate (5xx %)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"api-gateway\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{job=\"api-gateway\"}[5m])) * 100",
          "legendFormat": "%5xx"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent" }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Tasa por status (5m)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"api-gateway\"}[5m])) by (status)"
        }
      ]
    },
    {
      "id": 6,
      "type": "barchart",
      "title": "Top endpoints (5m)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "topk(8, sum(rate(http_requests_total{job=\"api-gateway\"}[5m])) by (path))"
        }
      ]
    },
    {
      "id": 7,
      "type": "row",
      "title": "Salud de servicios",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "collapsed": false
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Servicios up",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "up",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null } ] }
        }
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "Negocio (eventos Kafka)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
      "collapsed": false
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Ventas vs Compras /min",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(sales_created_total[1m]))", "legendFormat": "ventas" },
        { "expr": "sum(rate(purchases_created_total[1m]))", "legendFormat": "compras" }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Acumulados",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(sales_created_total)", "legendFormat": "ventas" },
        { "expr": "sum(purchases_created_total)", "legendFormat": "compras" },
        { "expr": "sum(products_created_total)", "legendFormat": "productos" },
        { "expr": "sum(clients_created_total)", "legendFormat": "clientes" }
      ]
    },
    {
      "id": 12,
      "type": "row",
      "title": "Logs (Loki)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 33 },
      "collapsed": false
    },
    {
      "id": 13,
      "type": "logs",
      "title": "Errores del gateway (status >= 500)",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 34 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{service=\"gateway\"} | json | statusCode >= 500",
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "type": "logs",
      "title": "Últimos logs del gateway",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 44 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{service=\"gateway\"}",
          "refId": "B"
        }
      ]
    }
  ]
}