PORT=3000

JWT_SECRET=tu-secret-jwt-aqui
JWT_EXPIRATION=24h

MS_USERS_URL=http://localhost:3001
MS_PRODUCTS_URL=http://localhost:3002
MS_SALES_URL=http://localhost:3003

KAFKA_BROKER=localhost:9094
KAFKA_CLIENT_ID=api-gateway

THROTTLE_TTL=60
THROTTLE_LIMIT=100

# --- Resiliencia ---
# Timeout por servicio (ms). Usar TIMEOUT_<SERVICIO> para override individual: TIMEOUT_USERS, TIMEOUT_PRODUCTS, TIMEOUT_SALES
TIMEOUT=5000

# Retry con backoff exponencial. Override por servicio: RETRY_MAX_USERS, RETRY_BASE_DELAY_PRODUCTS, etc.
RETRY_MAX=3
RETRY_BASE_DELAY=1000

# Circuit Breaker. Override por servicio: CB_TIMEOUT_USERS, CB_RESET_TIMEOUT_PRODUCTS, etc.
CB_TIMEOUT=5000
CB_ERROR_THRESHOLD=50
CB_RESET_TIMEOUT=30000
